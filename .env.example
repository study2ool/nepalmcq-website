# =============================================================================
# Nepal MCQ Website Environment Configuration
# =============================================================================

# LOCAL DEVELOPMENT:
# Keep VITE_API_BASE_URL as /api/v1 (Vite proxy forwards /api to localhost:5001)
VITE_API_BASE_URL=/api/v1
VITE_BACKEND_URL=http://localhost:5001

# PRODUCTION DEPLOYMENT (e.g. Cloudflare Pages):
# Set this in your Cloudflare Pages Dashboard (Settings -> Environment variables):
# VITE_API_BASE_URL=https://<YOUR-DEPLOYED-BACKEND-DOMAIN>/api/v1

# Google OAuth Web Client ID (same ID configured in Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
